{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM"]
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.vue", "bmext/*.d.ts", "frontend/env.d.ts"]
}
